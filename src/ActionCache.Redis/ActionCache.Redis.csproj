<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ActionCache.Redis</PackageId>
    <Description>Redis backend for ActionCache, including distributed single-flight and keyspace-notification driven expiry.</Description>
    <PackageTags>cache;redis;aspnetcore;distributed-cache</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(_TargetVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ActionCache/ActionCache.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts/SetHash.lua" />
    <EmbeddedResource Include="Scripts/Remove.lua" />
    <EmbeddedResource Include="Scripts/RemoveNamespace.lua" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Unit" />
  </ItemGroup>

</Project>
